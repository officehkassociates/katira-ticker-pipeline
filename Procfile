# Procfile -- used by Railway, Heroku, and similar platforms that read
# this file to know how to start your service.
#
# Railway usage:
#   1. Push this repo to GitHub.
#   2. In Railway: New Project -> Deploy from GitHub repo -> select this repo.
#   3. Set the service's Root Directory to `api` in Railway's settings
#      (Settings -> Service -> Root Directory), since package.json lives
#      in api/, not the repo root.
#   4. Railway detects Node automatically and runs the command below.
#   5. Generate a public domain under Settings -> Networking, then use
#      that URL (or a custom domain mapped to it) as window.TICKER_API_BASE.
web: npm start
